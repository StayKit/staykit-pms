# ─────────────────────────────────────────────────────────────────────────────
# StayKit environment. Copy to `.env` and fill in. `npm run setup` validates the DB.
# ─────────────────────────────────────────────────────────────────────────────

# Database (SQLite). A relative path is resolved against the project root by the app.
# For absolute determinism across the Prisma CLI and the runtime, an absolute path
# is recommended in production, e.g. file:/data/staykit.db
DATABASE_URL="file:./data/staykit.db?connection_limit=1"

# Public base URL — used for Razorpay callbacks, MCP resource indicators and OAuth metadata.
# Must be https for any non-localhost host: Claude.ai's remote MCP connector refuses
# http endpoints. Behind a TLS-terminating proxy, set the public https URL here (an
# http value for a real host is auto-upgraded to https in the published metadata).
APP_BASE_URL="http://localhost:3000"

# Secret pepper mixed into OTP hashes. Generate a long random string in production.
OTP_PEPPER="change-me-to-a-long-random-string"

# Require a real login (disables the dev/demo owner fallback in the UI and MCP).
# REQUIRE_LOGIN="1"

# ── Razorpay (Payment Links) ────────────────────────────────────────────────
# Leave keys blank to run in mock mode (fake links, no live charges).
RAZORPAY_MODE="test"                 # test | live
RAZORPAY_KEY_ID_TEST=""
RAZORPAY_KEY_SECRET_TEST=""
RAZORPAY_WEBHOOK_SECRET_TEST=""
RAZORPAY_KEY_ID_LIVE=""
RAZORPAY_KEY_SECRET_LIVE=""
RAZORPAY_WEBHOOK_SECRET_LIVE=""

# ── Notifications ───────────────────────────────────────────────────────────
# When unset, notifications are logged to the console instead of sent.
MSG91_AUTH_KEY=""                    # SMS + WhatsApp (DLT-compliant)
MSG91_SENDER_ID=""
RESEND_API_KEY=""                    # transactional email
EMAIL_FROM="bookings@example.in"

# ── File storage / encryption ───────────────────────────────────────────────
# 32-byte key (hex/base64) for AES-256-GCM encryption of guest ID documents.
FILE_ENCRYPTION_KEY=""
STORAGE_BACKEND="local"              # local | s3

# ── Litestream (SQLite → S3 backups) ────────────────────────────────────────
LITESTREAM_ENDPOINT=""
LITESTREAM_BUCKET=""
LITESTREAM_ACCESS_KEY=""
LITESTREAM_SECRET=""
