# StayKit — per-tenant environment.
# Rendered by ops/bin/provision-tenant.sh from this template. Secrets are
# generated fresh per tenant; never reuse them across tenants.
#
# After editing this file: `docker compose -f docker-compose.yml restart app`.

# ── Identity / URLs ─────────────────────────────────────────────────────────
APP_BASE_URL="https://${SLUG}.staykit.app"
NODE_ENV="production"
REQUIRE_LOGIN="1"

# ── Database (absolute path inside the container; the host volume is ./data) ─
DATABASE_URL="file:/data/staykit.db?connection_limit=1"

# ── Uploads ─────────────────────────────────────────────────────────────────
STAYKIT_UPLOAD_DIR="/data/uploads"

# ── Secrets (generated per tenant by provision-tenant.sh; do not reuse) ─────
OTP_PEPPER="${OTP_PEPPER}"
FILE_ENCRYPTION_KEY="${FILE_ENCRYPTION_KEY}"

# ── Razorpay (Payment Links) — fill in with the tenant's own keys ───────────
# Leave blank to keep the tenant in mock mode (no live charges).
RAZORPAY_MODE="test"
RAZORPAY_KEY_ID_TEST=""
RAZORPAY_KEY_SECRET_TEST=""
RAZORPAY_WEBHOOK_SECRET_TEST=""
RAZORPAY_KEY_ID_LIVE=""
RAZORPAY_KEY_SECRET_LIVE=""
RAZORPAY_WEBHOOK_SECRET_LIVE=""
# Webhook URL to register in Razorpay dashboard:
#   https://${SLUG}.staykit.app/api/razorpay/webhook

# ── Notifications — fill in with the tenant's own keys ──────────────────────
# When unset, OTPs and notifications are logged to the app container's stdout.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_WHATSAPP_NUMBER=""
RESEND_API_KEY=""
EMAIL_FROM="bookings@${SLUG}.staykit.app"

# ── Litestream — S3 destination for this tenant's SQLite backups ────────────
# One bucket is fine; the path prefix isolates tenants. Use an India-region
# bucket (ap-south-1) or Cloudflare R2 with India restriction for DPDP.
LITESTREAM_ENDPOINT="${LITESTREAM_ENDPOINT}"
LITESTREAM_BUCKET="${LITESTREAM_BUCKET}"
LITESTREAM_PATH="${SLUG}/db"
LITESTREAM_ACCESS_KEY="${LITESTREAM_ACCESS_KEY}"
LITESTREAM_SECRET="${LITESTREAM_SECRET}"
